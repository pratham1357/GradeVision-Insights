{
  "name": "@gradevision/hint-engine",
  "version": "0.0.0",
  "private": true,
  "description": "GradeVision Insights hint-engine service (progressive AI hints, backend-only LLM provider).",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@gradevision/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
