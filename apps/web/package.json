{
  "name": "@gradevision/web",
  "version": "0.0.0",
  "private": true,
  "description": "GradeVision Insights web client (React + Vite + TypeScript).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
