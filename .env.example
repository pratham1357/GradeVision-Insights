# GradeVision Insights - example environment configuration
# Copy this file to `.env` and fill in real values locally.
# NEVER commit a populated `.env` file or real credentials.

# ---------- General ----------
NODE_ENV=development

# ---------- apps/api (Express REST API) ----------
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of allowed CORS origins for the web client.
# Also applied to the Socket.IO endpoint the API serves at /realtime (same port).
API_CORS_ORIGIN=http://localhost:5173

# ---------- Authentication (apps/api) ----------
# First-stage JWT access tokens only (no refresh tokens / SSO yet).
# Required. Must be >= 32 chars. Generate one with:  openssl rand -base64 48
JWT_SECRET=
# Access-token lifetime (vercel/ms format: 15m, 1h, 7d, or seconds as a number).
JWT_EXPIRES_IN=15m

# ---------- apps/web (React + Vite client) ----------
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
VITE_API_BASE_URL=http://localhost:4000

# ---------- services/evaluator (compiler-driven code evaluation) ----------
EVALUATOR_PORT=4100
# Self-hosted Judge0 sandbox (see infrastructure/docker/docker-compose.yml).
# Leave JUDGE0_URL unset to run without a sandbox: evaluation then marks runs
# FAILED with a clear "execution sandbox not configured" reason.
# JUDGE0_URL=http://localhost:2358
# JUDGE0_TOKEN=
# Judge0 CE language ids (defaults shown; only override for a custom image).
# JUDGE0_LANG_C=50
# JUDGE0_LANG_CPP=54
# JUDGE0_LANG_JAVA=62
# JUDGE0_LANG_PYTHON=71
# JUDGE0_LANG_JAVASCRIPT=63
# Poller cadence + parallelism for the PostgreSQL fallback path.
EVALUATOR_POLL_INTERVAL_MS=2000
EVALUATOR_CONCURRENCY=2
# Interpreter for the Python AST semantic analyzer (and for local Python
# execution when LOCAL_EXECUTION_ENABLED is on). Empty disables both.
PYTHON_BIN=python3
# --- LOCAL execution (evaluator; opt-in; local development / demo ONLY) ---
# Runs student programs as child processes with the toolchains installed on THIS
# host: real compilation + execution, real stdout compared by the grading engine.
# Isolation is demo-grade only: a per-case wall-clock kill, capped output, a
# scrubbed environment and a throwaway temp dir - but NO memory/CPU limits, NO
# network restriction, NO filesystem jail; code runs as the evaluator's OS user.
# Only takes effect while JUDGE0_URL is unset; wins over the Gemini fallback.
# Never enable on a shared or production host. Default off.
# LOCAL_EXECUTION_ENABLED=false
# Toolchains (names on PATH or absolute paths). Python uses PYTHON_BIN above.
# Set one to empty to disable the languages that need it.
# LOCAL_NODE_BIN=node
# LOCAL_GCC_BIN=gcc
# LOCAL_GXX_BIN=g++
# LOCAL_JAVAC_BIN=javac
# LOCAL_JAVA_BIN=java
# Wall-clock ceilings (ms): per case when the question sets no time limit
# (otherwise the question's CPU limit + 3 s), and for the compile step.
# LOCAL_EXECUTION_DEFAULT_WALL_TIME_MS=5000
# LOCAL_EXECUTION_COMPILE_TIMEOUT_MS=20000
# --- TEMPORARY demo/testing execution fallback (evaluator) ---
# Judge0 is the intended sandbox. ONLY when JUDGE0_URL is unset, this flag is
# "true", AND a backend GEMINI_API_KEY is present, the evaluator approximates
# execution results with a Gemini model so the pipeline stays functional for a
# demo. It never assigns scores - the existing grading engine still does. This
# is a stopgap: unset it and set JUDGE0_URL to return to the real sandbox.
# Default off. The Gemini key stays server-side only (never VITE_/browser).
# GEMINI_EXECUTION_FALLBACK_ENABLED=false
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_EXECUTION_TIMEOUT_MS=20000

# ---------- services/hint-engine (progressive AI hints / AI mentor) ----------
HINT_ENGINE_PORT=4200
# The API calls the hint-engine over HTTP (backend-only; never from the browser).
HINT_ENGINE_URL=http://localhost:4200
# Optional shared secret; when set, the API sends it and the hint-engine requires it.
# INTERNAL_SERVICE_TOKEN=
# LLM provider - entirely env-driven, no keys/models in code.
# Without GEMINI_API_KEY the hint-engine still serves static hints and returns a
# clear 503 for interactive hints (it never fabricates an AI response).
LLM_PROVIDER=gemini
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---------- Database (PostgreSQL + Prisma) ----------
# Local development connection string. Use fake local credentials only.
DATABASE_URL="postgresql://gradevision:gradevision_dev_pw@localhost:5432/gradevision?schema=public"
# Optional: only needed for `prisma migrate` against a DB where the app user
# cannot create databases (e.g. some managed Postgres). Leave unset locally.
# SHADOW_DATABASE_URL="postgresql://gradevision:gradevision_dev_pw@localhost:5432/gradevision_shadow?schema=public"

# ---------- Cache / queue (Redis) ----------
# Optional. When set, the API enqueues submissions for the evaluator via BullMQ.
# When unset, the evaluator polls PostgreSQL for QUEUED submissions instead.
# REDIS_URL=redis://localhost:6379
