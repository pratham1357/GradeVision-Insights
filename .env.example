# GradeVision Insights - example environment configuration
# Copy this file to `.env` and fill in real values locally.
# NEVER commit a populated `.env` file or real credentials.

# ---------- General ----------
NODE_ENV=development

# ---------- apps/api (Express REST API) ----------
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of allowed CORS origins for the web client.
API_CORS_ORIGIN=http://localhost:5173

# ---------- apps/web (React + Vite client) ----------
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
VITE_API_BASE_URL=http://localhost:4000

# ---------- services/evaluator (compiler-driven code evaluation) ----------
EVALUATOR_PORT=4100
# Judge0 integration is added in a later task.
# JUDGE0_BASE_URL=
# JUDGE0_API_KEY=

# ---------- services/hint-engine (progressive AI hints / AI mentor) ----------
HINT_ENGINE_PORT=4200
# LLM provider configuration is added in a later task.
# LLM_PROVIDER=
# LLM_API_KEY=

# ---------- Database (PostgreSQL + Prisma) ----------
# Local development connection string. Use fake local credentials only.
DATABASE_URL="postgresql://gradevision:gradevision_dev_pw@localhost:5432/gradevision?schema=public"
# Optional: only needed for `prisma migrate` against a DB where the app user
# cannot create databases (e.g. some managed Postgres). Leave unset locally.
# SHADOW_DATABASE_URL="postgresql://gradevision:gradevision_dev_pw@localhost:5432/gradevision_shadow?schema=public"

# ---------- Cache / live state (Redis) - configured in a later task ----------
# REDIS_URL=redis://localhost:6379
