{
  "name": "gradevision-insights",
  "version": "0.0.0",
  "private": true,
  "description": "Large-scale academic programming assessment platform.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"@gradevision/database\" build && pnpm -r --filter \"./apps/**\" --filter \"./services/**\" build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r run test",
    "clean": "pnpm -r exec rimraf dist .turbo *.tsbuildinfo",
    "db:generate": "pnpm --filter @gradevision/database generate",
    "db:migrate": "pnpm --filter @gradevision/database migrate",
    "db:seed": "pnpm --filter @gradevision/database seed",
    "db:studio": "pnpm --filter @gradevision/database studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
